<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appBackgroundColor">

    <TextView
        android:id="@+id/headerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textColor="@color/white"
        android:textSize="48sp"
        app:layout_constraintBottom_toTopOf="@+id/cardBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="150dp"
        android:layout_marginBottom="-50dp"
        app:cardBackgroundColor="@color/cardBackground"
        app:cardCornerRadius="50dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/languageHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/containerPadding"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="@dimen/containerPadding"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/language"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cardBackground" />

    <Spinner
        android:id="@+id/language_spinner"
        android:layout_width="150dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/containerPadding"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_custom_spinner_mini"
        android:clipToOutline="true"
        android:elevation="5dp"
        android:foreground="?android:attr/selectableItemBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/languageHeader" />

    <ImageView
        android:id="@+id/languageSpinnerArrow"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:elevation="5dp"
        android:focusable="false"
        app:tint="@color/black"
        app:layout_constraintBottom_toBottomOf="@+id/language_spinner"
        app:layout_constraintEnd_toEndOf="@+id/language_spinner"
        app:layout_constraintTop_toTopOf="@+id/language_spinner"
        app:srcCompat="@drawable/ic_angle_down_solid_full" />

    <TextView
        android:id="@+id/accountSettingsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/containerPadding"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/account_settings"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/language_spinner" />

    <ImageView
        android:id="@+id/accountSettingsArrow"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/accountSettingsText"
        app:layout_constraintStart_toEndOf="@+id/accountSettingsText"
        app:layout_constraintTop_toTopOf="@+id/accountSettingsText"
        app:srcCompat="@drawable/ic_angle_right_solid_full"
        app:tint="@color/black" />

    <TextView
        android:id="@+id/logOutText"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/containerPadding"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="@dimen/containerPadding"
        android:background="@drawable/bg_log_out"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:elevation="5dp"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="@string/log_out"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/accountSettingsText" />

    <ImageView
        android:id="@+id/logOutIcon"
        android:layout_width="25dp"
        android:layout_height="30dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="@null"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/logOutText"
        app:layout_constraintEnd_toEndOf="@+id/logOutText"
        app:layout_constraintTop_toTopOf="@+id/logOutText"
        app:srcCompat="@drawable/ic_arrow_right_from_bracket_solid_full" />

</androidx.constraintlayout.widget.ConstraintLayout>